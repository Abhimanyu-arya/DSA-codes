// problem statement - given an array of numbers, find the majority elements occuring over (>n(size of array)/3) times
//brute - sort the array and use a pointer
//better - use hash mapping
//optimal - use two pointers


#include <bits/stdc++.h>
using namespace std;

// majority element of an array 
// optimal method - use 2 pointers

vector<int> MajorityElements(vector<int>& arr){
    int n=arr.sizeof();
    int min=n/3;
    vector<int> output;
    int lmt1;
    int lmt2;
    int cnt1=0;
    int cnt2=0;
    for(int i=0; i<n; i++){
        if(cnt1==0 && arr[i]!=lmt2){
            lmt1=arr[i];
            cnt1=1;
        }
        else if(cnt2==0 && arr[i]!=lmt1){
            lmt2=arr[i];
            cnt1=1;
        }
        else if(arr[i]==lmt1){
            cnt1++;
        }
        else if(arr[i]==lmt2){
            cnt2++;
        }
        else{
            cnt1--;
            cnt2--;
        }
        
    }
//we have simply found the 2 majority elements till now, we need to check if they occur more than n/3 times

    cnt1==0;
    cnt2==0;
    for(int j=0; j<n; j++){
        if(arr[i]==lmt1){
            cnt1++;
        }
        if(arr[i]==lmt2){
            cnt2++;
        }
        
    }
    if(cnt1>min){
        output.push_back(lmt1);
    }
    if(cnt2>min){
        output.push_back(lmt2);
    }
    return output;
}
